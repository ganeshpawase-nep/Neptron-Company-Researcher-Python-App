
BROWSER_CHANNEL=chrome
BROWSER_TIMEOUT_MS=18000
SEARCH_TIMEOUT_MS=18000
MAX_SEARCH_RESULTS=15
MAX_QUERIES=6
MAX_WEBSITE_DOMAINS=5

# Production default: close browser after the complete batch.
KEEP_BROWSER_OPEN=false

USE_PERSISTENT_PROFILE=true
PROFILE_DIR=browser_profile

# Primary search uses the company name exactly as supplied in Excel.

CANDIDATE_NAVIGATION_ATTEMPTS=3

# Production stability bounds
MAX_INTERNAL_PAGES=6
INDUSTRY_SEARCH_RESULTS=8
INDUSTRY_SEARCH_TIMEOUT_MS=18000

# DuckDuckGo Search Assist timing (required profile enrichment flow)
SEARCH_ASSIST_OPEN_WAIT_MS=15000
SEARCH_ASSIST_MAX_WAIT_MS=90000
SEARCH_ASSIST_EXPANDED_WAIT_MS=120000
COMPANY_TIMEOUT_MS=360000
CANDIDATE_NAVIGATION_ATTEMPTS=3

# Allows the one-time manual LinkedIn login using the persistent browser profile.
LINKEDIN_LOGIN_ENABLED=true

INDUSTRY_SECTOR_TIMEOUT_MS=300000
